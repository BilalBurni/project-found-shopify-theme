          "blocks": {
            "auth_eyebrow": {
              "type": "text",
              "settings": {
                "text": "<p>Authenticity</p>",
                "type_preset": "h6",
                "text_color": "#FF0000",
                "width": "fit-content"
              }
            },
            "auth_title": {
              "type": "text",
              "settings": {
                "text": "<h2>Real Fragrance. Nothing Else.</h2>",
                "type_preset": "h3",
                "width": "100%",
                "max_width": "normal"
              }
            },
            "auth_body": {
              "type": "text",
              "settings": {
                "text": "<p>Every Project Found decant is filled from an authentic retail bottle. Nothing is diluted, mixed or substituted. We decant by hand, in small batches, into clean glass atomizers.</p><p>Project Found decants are prepared independently. We are not affiliated with, endorsed by, or sponsored by any of the designer fragrance houses whose fragrances we decant.</p>",
                "type_preset": "rte",
                "text_color": "{{ settings.color_palette.color1 }}",
                "width": "100%",
                "max_width": "normal"
              }
            }
          },
          "block_order": [
            "auth_eyebrow",
            "auth_title",
            "auth_body"
          ]
        }
      },
      "settings": {
        "media_position": "right",
        "media_width": "medium",
        "media_height": "80svh",
        "section_width": "full-width",
        "extend_media": true,
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
