                "type_preset": "h3",
                "width": "100%",
                "max_width": "normal"
              }
            },
            "why_body": {
              "type": "text",
              "settings": {
                "text": "<p>A full bottle is a commitment. A decant is not. Wear a fragrance for a week, build a rotation for the price of one bottle, and carry it anywhere in a small glass atomizer.</p>",
                "type_preset": "rte",
                "text_color": "{{ settings.color_palette.color1 }}",
                "width": "100%",
                "max_width": "normal"
              }
            },
            "why_cta": {
              "type": "button",
              "settings": {
                "label": "Shop Fragrances",
                "link": "shopify://collections/shop-fragrance",
                "style_class": "button-secondary"
              }
            }
          },
          "block_order": [
            "why_eyebrow",
            "why_title",
            "why_body",
            "why_cta"
          ]
        }
